<?xml version="1.0" encoding="UTF-8"?>
<configure-worker-modal>
    <!-- Modal Overlay -->
    <modal_overlay>
        <modal_container>
            <!-- Modal Header -->
            <modal_header>
                <navigation>
                    <close_button icon="close" action="close_modal">
                        <tooltip>Close Configuration</tooltip>
                    </close_button>
                </navigation>
                <title_section>
                    <main_title>Configure AI Worker</main_title>
                    <subtitle>Set up a new AI worker with specialized skills and tools</subtitle>
                </title_section>
            </modal_header>

            <!-- Configuration Content -->
            <configuration_content>
                <!-- Step 1: Choose Specialist Type -->
                <configuration_step id="step-1">
                    <step_header>
                        <step_number>1.</step_number>
                        <step_title>Choose Specialist Type</step_title>
                        <step_description>Select the primary role and expertise area for this AI
                            worker</step_description>
                    </step_header>

                    <!-- SAMPLE DATA: Specialist Type Cards -->
                    <specialist_types_grid>
                        <!-- Marketing Specialist -->
                        <specialist_card id="marketing" selected="true">
                            <card_header>
                                <icon>MS</icon>
                                <specialist_info>
                                    <name>Marketing Specialist</name>
                                    <description>Email campaigns, lead generation, content marketing</description>
                                </specialist_info>
                            </card_header>
                            <default_tools>
                                <tool>Mailchimp</tool>
                                <tool>HubSpot</tool>
                                <tool>Analytics</tool>
                            </default_tools>
                        </specialist_card>

                        <!-- Content Creator -->
                        <specialist_card id="content">
                            <card_header>
                                <icon>CC</icon>
                                <specialist_info>
                                    <name>Content Creator</name>
                                    <description>Blog writing, social media content, SEO
                                        optimization</description>
                                </specialist_info>
                            </card_header>
                            <default_tools>
                                <tool>WordPress</tool>
                                <tool>Canva</tool>
                            </default_tools>
                        </specialist_card>

                        <!-- Data Analyst -->
                        <specialist_card id="data_analyst">
                            <card_header>
                                <icon>DA</icon>
                                <specialist_info>
                                    <name>Data Analyst</name>
                                    <description>Performance tracking, report generation, insights</description>
                                </specialist_info>
                            </card_header>
                            <default_tools>
                                <tool>Analytics</tool>
                                <tool>Tableau</tool>
                            </default_tools>
                        </specialist_card>

                        <!-- Sales Specialist -->
                        <specialist_card id="sales">
                            <card_header>
                                <icon>SS</icon>
                                <specialist_info>
                                    <name>Sales Specialist</name>
                                    <description>Lead qualification, CRM management, sales analytics</description>
                                </specialist_info>
                            </card_header>
                            <default_tools>
                                <tool>Salesforce</tool>
                                <tool>HubSpot</tool>
                            </default_tools>
                        </specialist_card>
                    </specialist_types_grid>
                </configuration_step>

                <!-- Step 2: Worker Details -->
                <configuration_step id="step-2">
                    <step_header>
                        <step_number>2.</step_number>
                        <step_title>Worker Details</step_title>
                        <step_description>Customize the name, description, and behavior of your AI
                            worker</step_description>
                    </step_header>

                    <!-- Worker Configuration Form -->
                    <worker_details_form>
                        <!-- Worker Name -->
                        <form_field id="worker_name" required="true">
                            <label>Worker Name*</label>
                            <!-- SAMPLE DATA: Pre-filled based on specialist type -->
                            <input type="text" value="Marketing Specialist"
                                placeholder="Enter worker name" />
                            <help_text>Give your worker a memorable name that reflects their role</help_text>
                        </form_field>

                        <!-- Description -->
                        <form_field id="description" required="true">
                            <label>Description*</label>
                            <!-- SAMPLE DATA: Marketing specialist description -->
                            <textarea placeholder="Describe the worker's role and responsibilities">Expert
                                in email campaigns, lead generation, content marketing, and
                                analytics. Helps create and optimize marketing campaigns to drive
                                engagement and conversions.</textarea>
                            <help_text>This description helps users understand when to use this
                                worker</help_text>
                        </form_field>

                        <!-- Personality and Behavior Configuration -->
                        <behavior_configuration>
                            <!-- Personality Style -->
                            <form_field id="personality_style">
                                <label>Personality Style</label>
                                <dropdown selected="friendly">
                                    <option value="friendly">Friendly &amp; Conversational</option>
                                    <option value="professional">Professional &amp; Formal</option>
                                    <option value="casual">Casual &amp; Relaxed</option>
                                    <option value="technical">Technical &amp; Precise</option>
                                </dropdown>
                            </form_field>

                            <!-- Response Speed -->
                            <form_field id="response_speed">
                                <label>Response Speed</label>
                                <dropdown selected="balanced">
                                    <option value="fast">Fast (prioritize speed)</option>
                                    <option value="balanced">Balanced (speed + quality)</option>
                                    <option value="thorough">Thorough (prioritize quality)</option>
                                    <option value="custom">Custom Configuration</option>
                                </dropdown>
                            </form_field>
                        </behavior_configuration>
                    </worker_details_form>
                </configuration_step>

                <!-- Step 4: Configure Tools -->
                <configuration_step id="step-4">
                    <step_header>
                        <step_number>4.</step_number>
                        <step_title>Configure Tools</step_title>
                        <step_description>Select and configure the tools this worker can access</step_description>
                    </step_header>

                    <!-- Tool Categories -->
                    <tool_categories>
                        <category_tabs>
                            <tab id="communication" active="true">
                                <label>Communication &amp; Email</label>
                                <action>show_communication_tools</action>
                            </tab>
                            <tab id="design">
                                <label>Design &amp; Creative</label>
                                <action>show_design_tools</action>
                            </tab>
                            <tab id="analytics">
                                <label>Analytics &amp; Data</label>
                                <action>show_analytics_tools</action>
                            </tab>
                        </category_tabs>

                        <!-- SAMPLE DATA: Communication & Email Tools -->
                        <tools_grid category="communication">
                            <!-- Connected Tools -->
                            <tool_card id="mailchimp" status="connected" selected="true">
                                <tool_header>
                                    <icon>M</icon>
                                    <tool_info>
                                        <name>Mailchimp</name>
                                        <status_badge type="connected">Connected</status_badge>
                                    </tool_info>
                                </tool_header>
                                <tool_description>
                                    <capabilities>
                                        <item>Email marketing automation and campaigns</item>
                                        <item>Audience segmentation</item>
                                        <item>Create email campaigns</item>
                                        <item>Manage subscriber lists</item>
                                    </capabilities>
                                </tool_description>
                            </tool_card>

                            <tool_card id="hubspot" status="connected" selected="true">
                                <tool_header>
                                    <icon>H</icon>
                                    <tool_info>
                                        <name>HubSpot</name>
                                        <status_badge type="connected">Connected</status_badge>
                                    </tool_info>
                                </tool_header>
                                <tool_description>
                                    <capabilities>
                                        <item>CRM, marketing automation, and sales</item>
                                        <item>Lead tracking and nurturing</item>
                                        <item>Manage contacts and leads</item>
                                        <item>Email sequences</item>
                                    </capabilities>
                                </tool_description>
                            </tool_card>

                            <!-- Available Tools -->
                            <tool_card id="gmail" status="available">
                                <tool_header>
                                    <icon>G</icon>
                                    <tool_info>
                                        <name>Gmail</name>
                                        <status_badge type="available">Available</status_badge>
                                    </tool_info>
                                </tool_header>
                                <tool_description>
                                    <capabilities>
                                        <item>Email communication and organization</item>
                                        <item>Message management</item>
                                    </capabilities>
                                </tool_description>
                                <connect_button type="secondary">
                                    <label>Connect Gmail</label>
                                    <action>connect_gmail</action>
                                </connect_button>
                            </tool_card>

                            <tool_card id="slack" status="available">
                                <tool_header>
                                    <icon>S</icon>
                                    <tool_info>
                                        <name>Slack</name>
                                        <status_badge type="available">Available</status_badge>
                                    </tool_info>
                                </tool_header>
                                <tool_description>
                                    <capabilities>
                                        <item>Team communication and collaboration</item>
                                        <item>Channel management</item>
                                    </capabilities>
                                </tool_description>
                                <connect_button type="secondary">
                                    <label>Connect Slack</label>
                                    <action>connect_slack</action>
                                </connect_button>
                            </tool_card>
                        </tools_grid>
                    </tool_categories>

                    <!-- Tool Selection Summary -->
                    <tool_selection_summary>
                        <!-- SAMPLE DATA: Tool counts -->
                        <selection_stats>
                            <stat>
                                <value>2</value>
                                <label>tools selected</label>
                            </stat>
                            <stat>
                                <value>12</value>
                                <label>total available</label>
                            </stat>
                        </selection_stats>

                        <tool_actions>
                            <button type="secondary" icon="add">
                                <label>Browse More Tools</label>
                                <action>browse_more_tools</action>
                            </button>
                            <button type="secondary" icon="settings">
                                <label>Configure Selected</label>
                                <action>configure_selected_tools</action>
                            </button>
                        </tool_actions>
                    </tool_selection_summary>
                </configuration_step>
            </configuration_content>

            <!-- Worker Preview -->
            <worker_preview_section>
                <preview_header>
                    <title>Worker Preview</title>
                </preview_header>

                <!-- SAMPLE DATA: Preview of configured worker -->
                <worker_preview_card>
                    <worker_avatar>MS</worker_avatar>
                    <worker_summary>
                        <name>Marketing Specialist</name>
                        <tools_info>4 tools • 5.9K information</tools_info>
                    </worker_summary>
                </worker_preview_card>
            </worker_preview_section>

            <!-- Modal Footer Actions -->
            <modal_footer>
                <footer_actions>
                    <!-- Secondary Actions -->
                    <secondary_actions>
                        <button type="secondary" icon="save">
                            <label>Save as Template</label>
                            <action>save_as_template</action>
                        </button>
                        <button type="secondary" icon="test_tube">
                            <label>Test Configuration</label>
                            <action>test_configuration</action>
                        </button>
                    </secondary_actions>

                    <!-- Primary Actions -->
                    <primary_actions>
                        <button type="tertiary">
                            <label>Cancel</label>
                            <action>cancel_configuration</action>
                        </button>
                        <button type="primary" icon="add">
                            <label>Create Worker</label>
                            <action>create_worker</action>
                        </button>
                    </primary_actions>
                </footer_actions>
            </modal_footer>
        </modal_container>
    </modal_overlay>
</configure-worker-modal> 