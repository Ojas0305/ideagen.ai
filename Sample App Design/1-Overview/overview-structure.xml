<?xml version="1.0" encoding="UTF-8"?>
<overview-dashboard>
    <!-- Top Navigation Bar -->
    <top_navigation>
        <left_section>
            <company_logo>
                <name>Oven AI</name>
                <icon>oven_logo</icon>
                <link>/dashboard</link>
            </company_logo>
        </left_section>
        <right_section>
            <!-- SAMPLE DATA: User profile information -->
            <user_profile>
                <avatar>user_avatar.jpg</avatar>
                <name>John Smith</name>
                <role>Executive</role>
                <notifications_count>3</notifications_count>
                <dropdown_menu>
                    <item action="profile">My Profile</item>
                    <item action="settings">Settings</item>
                    <item action="help">Help &amp; Support</item>
                    <item action="logout">Sign Out</item>
                </dropdown_menu>
            </user_profile>
        </right_section>
    </top_navigation>

    <main_layout>
        <!-- Left Sidebar Navigation -->
        <left_sidebar>
            <navigation_title>DASHBOARD</navigation_title>
            <nav_items>
                <nav_item id="overview" icon="dashboard" active="true">
                    <label>Overview</label>
                    <target_content>/overview</target_content>
                </nav_item>
                <nav_item id="organizations" icon="corporate_fare">
                    <label>Organizations</label>
                    <target_content>/organizations</target_content>
                </nav_item>
                <nav_item id="processes" icon="account_tree">
                    <label>Processes</label>
                    <target_content>/processes</target_content>
                </nav_item>
                <nav_item id="workers" icon="smart_toy">
                    <label>Workers</label>
                    <target_content>/workers</target_content>
                </nav_item>
                <nav_item id="integrations" icon="extension">
                    <label>Integrations</label>
                    <target_content>/integrations</target_content>
                </nav_item>
                <nav_item id="active_tasks" icon="task_alt">
                    <label>Active Tasks</label>
                    <target_content>/active-tasks</target_content>
                </nav_item>
                <nav_item id="knowledge_base" icon="storage">
                    <label>Knowledge Base</label>
                    <target_content>/knowledge-base</target_content>
                </nav_item>
            </nav_items>
        </left_sidebar>

        <!-- Main Content Area -->
        <content_area>
            <!-- Header Section -->
            <header>
                <page_info>
                    <title>Overview</title>
                    <subtitle>Get an overview of your entire business</subtitle>
                    <!-- SAMPLE DATA: Last updated timestamp -->
                    <last_updated>Last updated: Jan 15, 2024 10:30 AM</last_updated>
                </page_info>
                <quick_actions>
                    <button type="primary" icon="add">Create Process</button>
                    <button type="secondary" icon="smart_toy">Add AI Worker</button>
                    <button type="tertiary" icon="link">Connect Data</button>
                </quick_actions>
            </header>

            <!-- SAMPLE DATA: Business Performance KPIs -->
            <business_kpis>
                <kpi_card>
                    <label>Monthly Revenue</label>
                    <value>$847,500</value>
                    <trend>
                        <direction>up</direction>
                        <percentage>+12.5%</percentage>
                        <indicator>positive</indicator>
                    </trend>
                    <target>
                        <value>$900,000</value>
                        <progress>94.2%</progress>
                    </target>
                </kpi_card>

                <kpi_card>
                    <label>Active Customers</label>
                    <value>1,247</value>
                    <trend>
                        <direction>up</direction>
                        <percentage>+8.3%</percentage>
                        <indicator>positive</indicator>
                    </trend>
                </kpi_card>

                <kpi_card>
                    <label>Automation Rate</label>
                    <value>78%</value>
                    <trend>
                        <direction>up</direction>
                        <percentage>+15%</percentage>
                        <indicator>positive</indicator>
                    </trend>
                </kpi_card>

                <kpi_card>
                    <label>Process Efficiency</label>
                    <value>85%</value>
                    <trend>
                        <direction>up</direction>
                        <percentage>+7%</percentage>
                        <indicator>positive</indicator>
                    </trend>
                </kpi_card>
            </business_kpis>

            <!-- SAMPLE DATA: Department Health Overview -->
            <department_health_overview>
                <section_title>Department Health Overview</section_title>

                <department_grid>
                    <department id="engineering" status="healthy">
                        <name>Engineering</name>
                        <health_score>85%</health_score>
                        <active_tasks>12</active_tasks>
                        <ai_workers>3</ai_workers>
                        <completion_rate>78%</completion_rate>
                        <last_activity>2 hours ago</last_activity>
                    </department>

                    <department id="sales" status="healthy">
                        <name>Sales</name>
                        <health_score>92%</health_score>
                        <active_tasks>8</active_tasks>
                        <ai_workers>2</ai_workers>
                        <completion_rate>94%</completion_rate>
                        <last_activity>30 minutes ago</last_activity>
                    </department>

                    <department id="marketing" status="warning">
                        <name>Marketing</name>
                        <health_score>71%</health_score>
                        <active_tasks>15</active_tasks>
                        <ai_workers>4</ai_workers>
                        <completion_rate>67%</completion_rate>
                        <last_activity>1 hour ago</last_activity>
                        <alert>
                            <type>warning</type>
                            <message>Completion rate below target</message>
                        </alert>
                    </department>

                    <department id="finance" status="healthy">
                        <name>Finance</name>
                        <health_score>88%</health_score>
                        <active_tasks>5</active_tasks>
                        <ai_workers>2</ai_workers>
                        <completion_rate>80%</completion_rate>
                        <last_activity>4 hours ago</last_activity>
                    </department>
                </department_grid>
            </department_health_overview>

            <bottom_section>
                <!-- SAMPLE DATA: System Status -->
                <system_status>
                    <section_title>System Status</section_title>

                    <ai_workers_status>
                        <title>AI Workers</title>
                        <total>15</total>
                        <active>11</active>
                        <idle>4</idle>
                        <utilization>73%</utilization>
                    </ai_workers_status>

                    <processes_status>
                        <title>Processes</title>
                        <total>127</total>
                        <active>89</active>
                        <draft>38</draft>
                        <success_rate>84%</success_rate>
                    </processes_status>

                    <tasks_status>
                        <title>Tasks</title>
                        <running>42</running>
                        <queued>18</queued>
                        <completed_today>156</completed_today>
                        <avg_completion_time>2.3h</avg_completion_time>
                    </tasks_status>
                </system_status>

                <!-- SAMPLE DATA: Alerts & Notifications -->
                <alerts_notifications>
                    <section_title>Alerts &amp; Notifications</section_title>
                    <priority_indicator>Priority</priority_indicator>

                    <alerts_list>
                        <alert id="alert-001" priority="high" department="engineering">
                            <timestamp>Jan 15, 9:43 AM</timestamp>
                            <title>Engineering - High Priority</title>
                            <message>API integration task failed - requires attention</message>
                            <affected_systems>Affected systems: 2</affected_systems>
                            <status>unread</status>
                        </alert>

                        <alert id="alert-002" priority="medium" department="marketing">
                            <timestamp>Jan 15, 8:30 AM</timestamp>
                            <title>Marketing - Medium Priority</title>
                            <message>Campaign automation process needs approval</message>
                            <status>unread</status>
                        </alert>

                        <alert id="alert-003" priority="info" department="sales">
                            <timestamp>Jan 15, 7:15 AM</timestamp>
                            <title>Sales - Info</title>
                            <message>Lead qualification process completed successfully</message>
                            <status>read</status>
                        </alert>
                    </alerts_list>
                </alerts_notifications>
            </bottom_section>

            <!-- SAMPLE DATA: Recent Activity Feed -->
            <recent_activity>
                <section_title>Recent Activity</section_title>

                <activity_list>
                    <activity id="activity-001" type="task_completed">
                        <timestamp>Jan 15, 10:25 AM</timestamp>
                        <status_icon>success</status_icon>
                        <title>Task Completed</title>
                        <description>Invoice processing automation completed (Finance)</description>
                        <details>
                            <ai_worker>Invoice Processor #1</ai_worker>
                            <result>31 invoices processed successfully</result>
                        </details>
                    </activity>

                    <activity id="activity-002" type="process_deployed">
                        <timestamp>Jan 15, 10:10 AM</timestamp>
                        <status_icon>deployed</status_icon>
                        <title>Process Deployed</title>
                        <description>Email campaign automation deployed (Marketing)</description>
                        <details>
                            <assignee>Marketing Manager</assignee>
                            <result>Process now active and running</result>
                        </details>
                    </activity>

                    <activity id="activity-003" type="worker_assigned">
                        <timestamp>Jan 15, 9:55 AM</timestamp>
                        <status_icon>assignment</status_icon>
                        <title>Worker Assigned</title>
                        <description>New task assigned to Content Creator #1 (Marketing)</description>
                        <details>
                            <system>System Auto-Assignment</system>
                            <result>Blog content strategy task queued</result>
                        </details>
                    </activity>
                </activity_list>
            </recent_activity>
        </content_area>
    </main_layout>
</overview-dashboard> 