<?xml version="1.0" encoding="UTF-8"?>
<knowledge_base_dashboard>
    <!-- Top Navigation Bar -->
    <top_navigation>
        <left_section>
            <company_logo>
                <name>Oven AI</name>
                <icon>oven_logo</icon>
                <link>/dashboard</link>
            </company_logo>
        </left_section>
        <right_section>
            <!-- SAMPLE DATA: User profile information -->
            <user_profile>
                <avatar>user_avatar.jpg</avatar>
                <name>John Smith</name>
                <role>Executive</role>
                <notifications_count>1</notifications_count>
                <dropdown_menu>
                    <item action="profile">My Profile</item>
                    <item action="settings">Settings</item>
                    <item action="help">Help &amp; Support</item>
                    <item action="logout">Sign Out</item>
                </dropdown_menu>
            </user_profile>
        </right_section>
    </top_navigation>

    <main_layout>
        <!-- Left Sidebar Navigation -->
        <left_sidebar>
            <navigation_title>DASHBOARD</navigation_title>
            <nav_items>
                <nav_item id="overview" icon="dashboard">
                    <label>Overview</label>
                    <target_content>/overview</target_content>
                </nav_item>
                <nav_item id="organizations" icon="corporate_fare">
                    <label>Organizations</label>
                    <target_content>/organizations</target_content>
                </nav_item>
                <nav_item id="processes" icon="account_tree">
                    <label>Processes</label>
                    <target_content>/processes</target_content>
                </nav_item>
                <nav_item id="workers" icon="smart_toy">
                    <label>Workers</label>
                    <target_content>/workers</target_content>
                </nav_item>
                <nav_item id="integrations" icon="extension">
                    <label>Integrations</label>
                    <target_content>/integrations</target_content>
                </nav_item>
                <nav_item id="active_tasks" icon="task_alt">
                    <label>Active Tasks</label>
                    <target_content>/active-tasks</target_content>
                </nav_item>
                <nav_item id="knowledge_base" icon="storage" active="true">
                    <label>Knowledge Base</label>
                    <target_content>/knowledge-base</target_content>
                </nav_item>
            </nav_items>
        </left_sidebar>

        <!-- Main Content Area -->
        <content_area>
            <!-- Page Header -->
            <header>
                <page_info>
                    <title>Knowledge Base</title>
                    <subtitle>Give AI workers access to your business knowledge</subtitle>
                    <!-- SAMPLE DATA: Last sync timestamp -->
                    <last_updated>Last updated: Jan 15, 2024 10:30 AM</last_updated>
                </page_info>
            </header>

            <!-- Key Performance Indicators -->
            <kpi_section>
                <!-- SAMPLE DATA: Knowledge source metrics -->
                <kpi_cards>
                    <kpi_card type="connected_sources">
                        <value>12</value>
                        <label>Connected Sources</label>
                        <icon>link</icon>
                        <status>success</status>
                    </kpi_card>

                    <kpi_card type="failed_connections">
                        <value>1</value>
                        <label>Failed Connections</label>
                        <icon>alert_triangle</icon>
                        <status>error</status>
                    </kpi_card>

                    <kpi_card type="last_sync">
                        <value>2 min</value>
                        <label>Last Sync</label>
                        <icon>refresh_cw</icon>
                        <status>success</status>
                    </kpi_card>
                </kpi_cards>
            </kpi_section>

            <!-- Main Content Layout -->
            <content_layout>
                <!-- Upload Documents Section -->
                <upload_documents_section>
                    <section_header>
                        <title>Upload Documents</title>
                        <subtitle>Upload files directly for analysis or integration into your
                            workflows</subtitle>
                    </section_header>

                    <!-- File Upload Area -->
                    <upload_area>
                        <drag_drop_zone>
                            <upload_icon>cloud_upload</upload_icon>
                            <primary_text>Drag and drop files here</primary_text>
                            <secondary_text>or click to browse your computer</secondary_text>
                            <upload_button>
                                <button type="primary" action="choose_files">
                                    <label>Choose Files</label>
                                </button>
                            </upload_button>
                        </drag_drop_zone>
                    </upload_area>

                    <!-- Upload Information -->
                    <upload_info>
                        <supported_formats>
                            <section_title>Supported Formats:</section_title>
                            <format_list>
                                <format_category>
                                    <category_name>Documents:</category_name>
                                    <formats>PDF, DOC, DOCX</formats>
                                </format_category>
                                <format_category>
                                    <category_name>Spreadsheets:</category_name>
                                    <formats>XLS, XLSX, CSV</formats>
                                </format_category>
                                <format_category>
                                    <category_name>Presentations:</category_name>
                                    <formats>PPT, PPTX</formats>
                                </format_category>
                                <format_category>
                                    <category_name>Text:</category_name>
                                    <formats>TXT, RTF, MD</formats>
                                </format_category>
                                <format_category>
                                    <category_name>Images:</category_name>
                                    <formats>JPG, PNG, GIF</formats>
                                </format_category>
                            </format_list>
                        </supported_formats>

                        <upload_limits>
                            <section_title>Upload Limits:</section_title>
                            <limit_list>
                                <limit_item>Max file size: 50MB</limit_item>
                                <limit_item>Max total: 500MB</limit_item>
                                <limit_item>Max files: 20 at once</limit_item>
                            </limit_list>
                        </upload_limits>
                    </upload_info>
                </upload_documents_section>

                <!-- Cloud Storage Platforms Section -->
                <cloud_storage_section>
                    <section_header>
                        <title>Cloud Storage Platforms</title>
                        <subtitle>Connect to popular cloud storage services to access your
                            documents, spreadsheets, and files</subtitle>
                    </section_header>

                    <!-- SAMPLE DATA: Cloud storage integrations -->
                    <storage_platforms>
                        <!-- Google Drive - Connected -->
                        <platform_card id="google_drive" status="connected">
                            <card_header>
                                <platform_logo>
                                    <icon type="google_drive" color="blue">drive</icon>
                                    <logo_background>blue</logo_background>
                                </platform_logo>

                                <platform_info>
                                    <name>Google Drive</name>
                                    <provider>Google</provider>
                                    <status_badge type="connected">Connected</status_badge>
                                </platform_info>

                                <health_info>
                                    <health_percentage>98%</health_percentage>
                                    <health_label>Health:</health_label>
                                    <data_size>145.2 GB</data_size>
                                </health_info>
                            </card_header>

                            <card_content>
                                <last_sync>
                                    <sync_time>Last sync: Jan 15, 10:28 AM</sync_time>
                                </last_sync>

                                <recent_activity>
                                    <activity_title>Recent Activity</activity_title>
                                    <activity_list>
                                        <activity_item>
                                            <action>uploaded</action>
                                            <file>Q4_Financial_Report.pdf</file>
                                        </activity_item>
                                        <activity_item>
                                            <action>modified</action>
                                            <file>Marketing_Strategy_2024.docx</file>
                                        </activity_item>
                                    </activity_list>
                                </recent_activity>
                            </card_content>

                            <card_actions>
                                <action_button type="secondary" icon="settings">
                                    <label>Configure</label>
                                    <action>configure_google_drive</action>
                                </action_button>
                                <action_button type="primary" icon="refresh">
                                    <label>Sync Now</label>
                                    <action>sync_google_drive</action>
                                </action_button>
                            </card_actions>
                        </platform_card>

                        <!-- Dropbox - Available -->
                        <platform_card id="dropbox" status="available">
                            <card_header>
                                <platform_logo>
                                    <icon type="dropbox" color="blue">dropbox</icon>
                                    <logo_background>blue</logo_background>
                                </platform_logo>

                                <platform_info>
                                    <name>Dropbox</name>
                                    <provider>Dropbox Inc.</provider>
                                    <status_badge type="available">Available</status_badge>
                                </platform_info>
                            </card_header>

                            <card_content>
                                <description>Connect to Dropbox for seamless file storage and
                                    sharing across your organization</description>

                                <features>
                                    <feature_title>Features:</feature_title>
                                    <feature_list>
                                        <feature>File synchronization</feature>
                                        <feature>Team collaboration</feature>
                                        <feature>Version history</feature>
                                    </feature_list>
                                </features>
                            </card_content>

                            <card_actions>
                                <action_button type="primary" icon="link">
                                    <label>Connect</label>
                                    <action>connect_dropbox</action>
                                </action_button>
                                <action_button type="secondary" icon="info">
                                    <label>Learn More</label>
                                    <action>learn_more_dropbox</action>
                                </action_button>
                            </card_actions>
                        </platform_card>

                        <!-- OneDrive - Available -->
                        <platform_card id="onedrive" status="available">
                            <card_header>
                                <platform_logo>
                                    <icon type="onedrive" color="blue">onedrive</icon>
                                    <logo_background>blue</logo_background>
                                </platform_logo>

                                <platform_info>
                                    <name>OneDrive</name>
                                    <provider>Microsoft</provider>
                                    <status_badge type="available">Available</status_badge>
                                </platform_info>
                            </card_header>

                            <card_content>
                                <description>Microsoft OneDrive integration for seamless Office 365
                                    document workflows</description>

                                <features>
                                    <feature_title>Features:</feature_title>
                                    <feature_list>
                                        <feature>Office 365 integration</feature>
                                        <feature>Real-time collaboration</feature>
                                        <feature>Enterprise security</feature>
                                    </feature_list>
                                </features>
                            </card_content>

                            <card_actions>
                                <action_button type="primary" icon="link">
                                    <label>Connect</label>
                                    <action>connect_onedrive</action>
                                </action_button>
                                <action_button type="secondary" icon="info">
                                    <label>Learn More</label>
                                    <action>learn_more_onedrive</action>
                                </action_button>
                            </card_actions>
                        </platform_card>
                    </storage_platforms>
                </cloud_storage_section>

                <!-- Databases & APIs Section -->
                <databases_apis_section>
                    <section_header>
                        <title>Databases &amp; APIs</title>
                        <subtitle>Connect to your databases, CRM systems, and other business
                            applications</subtitle>
                    </section_header>

                    <!-- SAMPLE DATA: Database and API integrations -->
                    <database_integrations>
                        <!-- MySQL Database - Connected -->
                        <database_card id="mysql_database" status="connected">
                            <card_header>
                                <database_logo>
                                    <icon type="mysql" color="orange">database</icon>
                                    <logo_background>orange</logo_background>
                                </database_logo>

                                <database_info>
                                    <name>MySQL Database</name>
                                    <provider>MySQL</provider>
                                    <status_badge type="connected">Connected</status_badge>
                                </database_info>

                                <health_info>
                                    <health_percentage>99%</health_percentage>
                                    <health_label>Health:</health_label>
                                </health_info>
                            </card_header>

                            <card_content>
                                <sync_info>
                                    <last_sync>Last sync: Jan 15, 10:30 AM</last_sync>
                                    <record_count>45,892 records</record_count>
                                    <data_size>892 MB</data_size>
                                </sync_info>
                            </card_content>

                            <card_actions>
                                <action_button type="secondary" icon="settings">
                                    <label>Configure</label>
                                    <action>configure_mysql</action>
                                </action_button>
                                <action_button type="tertiary" icon="check">
                                    <label>Test</label>
                                    <action>test_mysql</action>
                                </action_button>
                            </card_actions>
                        </database_card>

                        <!-- Salesforce CRM - Connected -->
                        <database_card id="salesforce_crm" status="connected">
                            <card_header>
                                <database_logo>
                                    <icon type="salesforce" color="blue">salesforce</icon>
                                    <logo_background>blue</logo_background>
                                </database_logo>

                                <database_info>
                                    <name>Salesforce CRM</name>
                                    <provider>Salesforce</provider>
                                    <status_badge type="connected">Connected</status_badge>
                                </database_info>

                                <health_info>
                                    <health_percentage>95%</health_percentage>
                                    <health_label>Health:</health_label>
                                </health_info>
                            </card_header>

                            <card_content>
                                <sync_info>
                                    <last_sync>Last sync: Jan 15, 10:28 AM</last_sync>
                                    <record_count>8,234 records</record_count>
                                    <api_calls>1,247 API calls today</api_calls>
                                </sync_info>
                            </card_content>

                            <card_actions>
                                <action_button type="secondary" icon="settings">
                                    <label>Configure</label>
                                    <action>configure_salesforce</action>
                                </action_button>
                                <action_button type="primary" icon="refresh">
                                    <label>Refresh</label>
                                    <action>refresh_salesforce</action>
                                </action_button>
                            </card_actions>
                        </database_card>

                        <!-- HubSpot - Pending -->
                        <database_card id="hubspot" status="pending">
                            <card_header>
                                <database_logo>
                                    <icon type="hubspot" color="orange">hubspot</icon>
                                    <logo_background>orange</logo_background>
                                </database_logo>

                                <database_info>
                                    <name>HubSpot</name>
                                    <provider>HubSpot</provider>
                                    <status_badge type="pending">Pending</status_badge>
                                </database_info>
                            </card_header>

                            <card_content>
                                <setup_progress>
                                    <progress_text>Authentication in progress</progress_text>
                                    <progress_bar>
                                        <percentage>45%</percentage>
                                        <bar_fill>45</bar_fill>
                                    </progress_bar>
                                    <completion_status>45% complete</completion_status>
                                </setup_progress>
                            </card_content>

                            <card_actions>
                                <action_button type="primary" icon="play">
                                    <label>Continue Setup</label>
                                    <action>continue_hubspot_setup</action>
                                </action_button>
                                <action_button type="secondary" icon="x">
                                    <label>Cancel</label>
                                    <action>cancel_hubspot_setup</action>
                                </action_button>
                            </card_actions>
                        </database_card>
                    </database_integrations>
                </databases_apis_section>
            </content_layout>
        </content_area>
    </main_layout>
</knowledge_base_dashboard> 