<?xml version="1.0" encoding="UTF-8"?>
<processes-dashboard>
    <!-- Top Navigation Bar -->
    <top_navigation>
        <left_section>
            <company_logo>
                <name>Oven AI</name>
                <icon>oven_logo</icon>
                <link>/dashboard</link>
            </company_logo>
        </left_section>
        <right_section>
            <!-- SAMPLE DATA: User profile information -->
            <user_profile>
                <avatar>user_avatar.jpg</avatar>
                <name>John Smith</name>
                <role>Executive</role>
                <notifications_count>1</notifications_count>
                <dropdown_menu>
                    <item action="profile">My Profile</item>
                    <item action="settings">Settings</item>
                    <item action="help">Help &amp; Support</item>
                    <item action="logout">Sign Out</item>
                </dropdown_menu>
            </user_profile>
        </right_section>
    </top_navigation>

    <main_layout>
        <!-- Left Sidebar Navigation -->
        <left_sidebar>
            <navigation_title>DASHBOARD</navigation_title>
            <nav_items>
                <nav_item id="overview" icon="dashboard">
                    <label>Overview</label>
                    <target_content>/overview</target_content>
                </nav_item>
                <nav_item id="organizations" icon="corporate_fare">
                    <label>Organizations</label>
                    <target_content>/organizations</target_content>
                </nav_item>
                <nav_item id="processes" icon="account_tree" active="true">
                    <label>Processes</label>
                    <target_content>/processes</target_content>
                </nav_item>
                <nav_item id="workers" icon="smart_toy">
                    <label>Workers</label>
                    <target_content>/workers</target_content>
                </nav_item>
                <nav_item id="integrations" icon="extension">
                    <label>Integrations</label>
                    <target_content>/integrations</target_content>
                </nav_item>
                <nav_item id="active_tasks" icon="task_alt">
                    <label>Active Tasks</label>
                    <target_content>/active-tasks</target_content>
                </nav_item>
                <nav_item id="knowledge_base" icon="storage">
                    <label>Knowledge Base</label>
                    <target_content>/knowledge-base</target_content>
                </nav_item>
            </nav_items>
        </left_sidebar>

        <!-- Main Content Area -->
        <content_area>
            <!-- Header Section -->
            <header>
                <page_info>
                    <title>Processes</title>
                    <!-- SAMPLE DATA: Company context -->
                    <company>TechFlow Solutions</company>
                    <!-- SAMPLE DATA: Last updated timestamp -->
                    <last_updated>Last updated: Jan 15, 2024 10:30 AM</last_updated>
                </page_info>
            </header>

            <!-- SAMPLE DATA: Key Performance Indicators -->
            <process_kpis>
                <kpi_card>
                    <label>Total Processes</label>
                    <value>127</value>
                    <trend>
                        <direction>up</direction>
                        <period_change>+5 today</period_change>
                        <indicator>positive</indicator>
                    </trend>
                </kpi_card>

                <kpi_card>
                    <label>Active Processes</label>
                    <value>89</value>
                    <status>Running</status>
                    <status_color>success</status_color>
                </kpi_card>

                <kpi_card>
                    <label>Success Rate</label>
                    <value>84%</value>
                    <trend>
                        <direction>up</direction>
                        <percentage>+1.3%</percentage>
                        <indicator>positive</indicator>
                    </trend>
                </kpi_card>

                <kpi_card>
                    <label>Avg Execution Time</label>
                    <value>2.7h</value>
                    <trend>
                        <direction>down</direction>
                        <percentage>-15%</percentage>
                        <indicator>positive</indicator>
                    </trend>
                </kpi_card>
            </process_kpis>

            <!-- SAMPLE DATA: Process Performance Overview -->
            <process_performance_overview>
                <section_title>Process Performance Overview</section_title>

                <performance_metrics>
                    <metric>
                        <label>Success Rate</label>
                        <value>84%</value>
                        <trend>
                            <direction>up</direction>
                            <percentage>+3%</percentage>
                            <indicator>positive</indicator>
                        </trend>
                    </metric>

                    <metric>
                        <label>Avg Execution Time</label>
                        <value>2.7h</value>
                        <trend>
                            <direction>down</direction>
                            <percentage>-15%</percentage>
                            <indicator>positive</indicator>
                        </trend>
                    </metric>

                    <metric>
                        <label>Automation Rate</label>
                        <value>78%</value>
                        <trend>
                            <direction>up</direction>
                            <percentage>+6%</percentage>
                            <indicator>positive</indicator>
                        </trend>
                    </metric>

                    <metric>
                        <label>Error Rate</label>
                        <value>2.1%</value>
                        <trend>
                            <direction>down</direction>
                            <percentage>-18%</percentage>
                            <indicator>positive</indicator>
                        </trend>
                    </metric>
                </performance_metrics>
            </process_performance_overview>

            <!-- Process Management Actions -->
            <process_actions>
                <button type="primary" icon="add">
                    <label>Create New Process</label>
                    <action>create_process</action>
                </button>
                <button type="secondary" icon="template">
                    <label>Browse Templates</label>
                    <action>browse_templates</action>
                </button>
                <button type="tertiary" icon="import">
                    <label>Import Process</label>
                    <action>import_process</action>
                </button>
            </process_actions>

            <!-- SAMPLE DATA: Existing Processes Table -->
            <existing_processes>
                <section_header>
                    <title>Existing Processes</title>
                    <filters>
                        <filter type="dropdown" id="status">
                            <label>Status</label>
                            <options>
                                <option value="all">All</option>
                                <option value="active">Active</option>
                                <option value="draft">Draft</option>
                                <option value="archived">Archived</option>
                            </options>
                        </filter>
                        <filter type="dropdown" id="persona">
                            <label>Persona</label>
                            <options>
                                <option value="all">All</option>
                                <option value="marketing">Marketing</option>
                                <option value="sales">Sales</option>
                                <option value="support">Support</option>
                            </options>
                        </filter>
                    </filters>
                </section_header>

                <processes_table>
                    <table_headers>
                        <header>Process Name</header>
                        <header>Assigned Worker</header>
                        <header>Integrations</header>
                        <header>Usage</header>
                        <header>Success Rate</header>
                        <header>Status</header>
                        <header>Actions</header>
                    </table_headers>

                    <process_row id="process-001" status="active">
                        <process_info>
                            <name>Weekly Newsletter Campaign</name>
                            <description>Email Marketing Specialist</description>
                        </process_info>
                        <assigned_worker>
                            <type>Email Marketing Specialist</type>
                            <worker_id>ems-001</worker_id>
                        </assigned_worker>
                        <integrations>
                            <integration>Mailchimp</integration>
                            <integration>Canva</integration>
                            <integration>Google Analytics</integration>
                        </integrations>
                        <usage_stats>
                            <count>23</count>
                            <label>Uses</label>
                        </usage_stats>
                        <success_rate>
                            <percentage>94%</percentage>
                            <label>Success</label>
                        </success_rate>
                        <status_badge>
                            <type>active</type>
                            <label>Active</label>
                        </status_badge>
                        <actions>
                            <action type="edit" icon="edit">Edit</action>
                            <action type="duplicate" icon="copy">Duplicate</action>
                            <action type="view" icon="visibility">View</action>
                        </actions>
                    </process_row>

                    <process_row id="process-002" status="active">
                        <process_info>
                            <name>Blog Post Content Creation</name>
                            <description>Content Creator</description>
                        </process_info>
                        <assigned_worker>
                            <type>Content Creator</type>
                            <worker_id>cc-001</worker_id>
                        </assigned_worker>
                        <integrations>
                            <integration>WordPress</integration>
                            <integration>Grammarly</integration>
                            <integration>Unsplash</integration>
                        </integrations>
                        <usage_stats>
                            <count>15</count>
                            <label>Uses</label>
                        </usage_stats>
                        <success_rate>
                            <percentage>87%</percentage>
                            <label>Success</label>
                        </success_rate>
                        <status_badge>
                            <type>active</type>
                            <label>Active</label>
                        </status_badge>
                        <actions>
                            <action type="edit" icon="edit">Edit</action>
                            <action type="duplicate" icon="copy">Duplicate</action>
                            <action type="view" icon="visibility">View</action>
                        </actions>
                    </process_row>

                    <process_row id="process-003" status="draft">
                        <process_info>
                            <name>Social Media Automation</name>
                            <description>Social Media Manager</description>
                        </process_info>
                        <assigned_worker>
                            <type>Social Media Manager</type>
                            <worker_id>smm-001</worker_id>
                        </assigned_worker>
                        <integrations>
                            <integration>Buffer</integration>
                            <integration>Canva</integration>
                            <integration>Facebook Business</integration>
                        </integrations>
                        <usage_stats>
                            <count>0</count>
                            <label>Uses</label>
                        </usage_stats>
                        <success_rate>
                            <percentage>N/A</percentage>
                            <label>Success</label>
                        </success_rate>
                        <status_badge>
                            <type>draft</type>
                            <label>Draft</label>
                        </status_badge>
                        <actions>
                            <action type="edit" icon="edit">Edit</action>
                            <action type="duplicate" icon="copy">Duplicate</action>
                            <action type="view" icon="visibility">View</action>
                        </actions>
                    </process_row>
                </processes_table>

                <!-- SAMPLE DATA: Pagination -->
                <pagination>
                    <info>Showing 1-10 of 27 processes</info>
                    <controls>
                        <button type="previous" disabled="true">&lt;</button>
                        <page_number active="true">1</page_number>
                        <page_number>2</page_number>
                        <page_number>3</page_number>
                        <button type="next">&gt;</button>
                    </controls>
                </pagination>
            </existing_processes>

            <bottom_section>
                <!-- SAMPLE DATA: Recent Process Activity -->
                <recent_process_activity>
                    <section_title>Recent Process Activity</section_title>

                    <activity_list>
                        <activity id="activity-001" type="deployment">
                            <timestamp>Jan 15, 10:15 AM</timestamp>
                            <status_icon>high</status_icon>
                            <title>Email Campaign Automation deployed in Marketing</title>
                            <details>
                                <assignee>Marketing Manager</assignee>
                                <timestamp_detail>Jan 15, 10:15 AM • Marketing Manager</timestamp_detail>
                            </details>
                            <priority_badge>High</priority_badge>
                        </activity>

                        <activity id="activity-002" type="update">
                            <timestamp>Jan 15, 8:45 AM</timestamp>
                            <status_icon>medium</status_icon>
                            <title>API Integration Workflow updated with new error handling</title>
                            <details>
                                <assignee>DevOps Specialist #1</assignee>
                                <timestamp_detail>Jan 15, 8:45 AM • DevOps Specialist #1</timestamp_detail>
                            </details>
                            <priority_badge>Medium</priority_badge>
                        </activity>
                    </activity_list>
                </recent_process_activity>

                <!-- SAMPLE DATA: Process Health Monitoring -->
                <process_health_monitoring>
                    <section_title>Process Health Monitoring</section_title>

                    <health_metrics>
                        <overall_health>
                            <label>Overall Health</label>
                            <score>84%</score>
                            <status>healthy</status>
                        </overall_health>

                        <error_rate>
                            <label>Error Rate</label>
                            <percentage>2.1%</percentage>
                            <status>healthy</status>
                        </error_rate>
                    </health_metrics>

                    <alerts>
                        <alert id="alert-001" priority="warning">
                            <icon>warning</icon>
                            <title>Social Media Posting: Success rate below threshold (72%)</title>
                            <description>Review posting schedule and content templates</description>
                            <timestamp>24h</timestamp>
                        </alert>
                    </alerts>
                </process_health_monitoring>
            </bottom_section>
        </content_area>
    </main_layout>
</processes-dashboard> 