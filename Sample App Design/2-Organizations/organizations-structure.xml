            </organizations-grid>

            <!-- SAMPLE DATA: Performance comparison charts -->
            <performance-comparison>
                <chart type="health-score">
                    <title>Organization Performance Comparison</title>
                    <subtitle>Health Score</subtitle>
                    <data>
                        <organization id="sales" value="92%" />
                        <organization id="finance" value="88%" />
                        <organization id="engineering" value="85%" />
                        <organization id="marketing" value="71%" />
                    </data>
                </chart>

                <chart type="completion-rate">
                    <title>Completion Rate</title>
                    <data>
                        <organization id="sales" value="94%" />
