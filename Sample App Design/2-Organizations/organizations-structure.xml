                    <!-- SAMPLE DATA: Engineering AI workers -->
                    <ai-workers>
                        <worker>
                            <name>DevOps Specialist #1</name>
                            <utilization>87%</utilization>
                            <status>active</status>
                        </worker>
                        <worker>
                            <name>Code Reviewer #1</name>
                            <utilization>92%</utilization>
                            <status>active</status>
                        </worker>
                        <worker>
                            <name>QA Automation #1</name>
