                    <!-- SAMPLE DATA: Engineering top processes -->
                    <top-processes>
                        <process>
                            <name>API Integration Workflow</name>
                            <usage>69%</usage>
                            <success-rate>96%</success-rate>
                        </process>
                        <process>
                            <name>Code Deployment Pipeline</name>
                            <usage>76%</usage>
                            <success-rate>98%</success-rate>
                        </process>
                        <process>
                            <name>Bug Tracking Automation</name>
                            <usage>45%</usage>
                            <success-rate>87%</success-rate>
                        </process>
