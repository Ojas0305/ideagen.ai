<?xml version="1.0" encoding="UTF-8"?>
<organizations-dashboard>
    <!-- Top Navigation Bar -->
    <top_navigation>
        <left_section>
            <company_logo>
                <name>Oven AI</name>
                <icon>oven_logo</icon>
                <link>/dashboard</link>
            </company_logo>
        </left_section>
        <right_section>
            <!-- SAMPLE DATA: User profile information -->
            <user_profile>
                <avatar>user_avatar.jpg</avatar>
                <name>John Smith</name>
                <role>Executive</role>
                <notifications_count>3</notifications_count>
                <dropdown_menu>
                    <item action="profile">My Profile</item>
                    <item action="settings">Settings</item>
                    <item action="help">Help &amp; Support</item>
                    <item action="logout">Sign Out</item>
                </dropdown_menu>
            </user_profile>
        </right_section>
    </top_navigation>

    <main_layout>
        <!-- Left Sidebar Navigation -->
        <left_sidebar>
            <navigation_title>DASHBOARD</navigation_title>
            <nav_items>
                <nav_item id="overview" icon="dashboard">
                    <label>Overview</label>
                    <target_content>/overview</target_content>
                </nav_item>
                <nav_item id="organizations" icon="corporate_fare" active="true">
                    <label>Organizations</label>
                    <target_content>/organizations</target_content>
                </nav_item>
                <nav_item id="processes" icon="account_tree">
                    <label>Processes</label>
                    <target_content>/processes</target_content>
                </nav_item>
                <nav_item id="workers" icon="smart_toy">
                    <label>Workers</label>
                    <target_content>/workers</target_content>
                </nav_item>
                <nav_item id="integrations" icon="extension">
                    <label>Integrations</label>
                    <target_content>/integrations</target_content>
                </nav_item>
                <nav_item id="active_tasks" icon="task_alt">
                    <label>Active Tasks</label>
                    <target_content>/active-tasks</target_content>
                </nav_item>
                <nav_item id="knowledge_base" icon="storage">
                    <label>Knowledge Base</label>
                    <target_content>/knowledge-base</target_content>
                </nav_item>
            </nav_items>
        </left_sidebar>

        <!-- Main Content Area -->
        <content_area>
            <!-- Header Section -->
            <header>
                <navigation>
                    <breadcrumb>
                        <item>Organizations</item>
                    </breadcrumb>
                    <!-- SAMPLE DATA: Company name and timestamp -->
                    <company>TechFlow Solutions</company>
                    <last-updated>Last updated: Jan 15, 2024 10:30 AM</last-updated>
                </navigation>
                <actions>
                    <button type="primary">Add Organization</button>
                    <button type="secondary">Import Organization</button>
                </actions>
            </header>

            <!-- SAMPLE DATA: Top-level summary metrics -->
            <summary-metrics>
                <metric>
                    <label>Total Departments</label>
                    <value>4</value>
                    <type>count</type>
                </metric>
                <metric>
                    <label>Healthy</label>
                    <value>3</value>
                    <type>count</type>
                    <status>positive</status>
                </metric>
                <metric>
                    <label>Warning</label>
                    <value>1</value>
                    <type>count</type>
                    <status>warning</status>
                </metric>
                <metric>
                    <label>Avg Health Score</label>
                    <value>84%</value>
                    <type>percentage</type>
                </metric>
                <metric>
                    <label>Active Tasks</label>
                    <value>40</value>
                    <type>count</type>
                </metric>
                <metric>
                    <label>AI Workers</label>
                    <value>11</value>
                    <type>count</type>
                </metric>
            </summary-metrics>

            <!-- Organization Cards Grid -->
            <organizations-grid>
                <!-- SAMPLE DATA: Engineering Organization -->
                <organization id="engineering">
                    <header>
                        <icon type="code" />
                        <title>Engineering</title>
                        <health-status value="85%" status="healthy" />
                        <actions>
                            <button>Edit</button>
                            <button>View Details</button>
                            <button>More</button>
                        </actions>
                    </header>

                    <!-- SAMPLE DATA: Engineering metrics -->
                    <metrics>
                        <metric>
                            <label>Active Processes</label>
                            <value>23</value>
                        </metric>
                        <metric>
                            <label>Active Tasks</label>
