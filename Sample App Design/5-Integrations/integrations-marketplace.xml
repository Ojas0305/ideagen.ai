<?xml version="1.0" encoding="UTF-8"?>
<integrations-marketplace>
    <!-- Top Navigation Bar -->
    <top_navigation>
        <left_section>
            <company_logo>
                <name>Oven AI</name>
                <icon>oven_logo</icon>
                <link>/dashboard</link>
            </company_logo>
        </left_section>
        <right_section>
            <!-- SAMPLE DATA: User profile information -->
            <user_profile>
                <avatar>user_avatar.jpg</avatar>
                <name>John Smith</name>
                <role>Executive</role>
                <notifications_count>1</notifications_count>
                <dropdown_menu>
                    <item action="profile">My Profile</item>
                    <item action="settings">Settings</item>
                    <item action="help">Help &amp; Support</item>
                    <item action="logout">Sign Out</item>
                </dropdown_menu>
            </user_profile>
        </right_section>
    </top_navigation>

    <main_layout>
        <!-- Left Sidebar Navigation -->
        <left_sidebar>
            <navigation_title>DASHBOARD</navigation_title>
            <nav_items>
                <nav_item id="overview" icon="dashboard">
                    <label>Overview</label>
                    <target_content>/overview</target_content>
                </nav_item>
                <nav_item id="organizations" icon="corporate_fare">
                    <label>Organizations</label>
                    <target_content>/organizations</target_content>
                </nav_item>
                <nav_item id="processes" icon="account_tree">
                    <label>Processes</label>
                    <target_content>/processes</target_content>
                </nav_item>
                <nav_item id="workers" icon="smart_toy">
                    <label>Workers</label>
                    <target_content>/workers</target_content>
                </nav_item>
                <nav_item id="integrations" icon="extension" active="true">
                    <label>Integrations</label>
                    <target_content>/integrations</target_content>
                </nav_item>
                <nav_item id="active_tasks" icon="task_alt">
                    <label>Active Tasks</label>
                    <target_content>/active-tasks</target_content>
                </nav_item>
                <nav_item id="knowledge_base" icon="storage">
                    <label>Knowledge Base</label>
                    <target_content>/knowledge-base</target_content>
                </nav_item>
            </nav_items>
        </left_sidebar>

        <!-- Main Content Area -->
        <content_area>
            <!-- Header Section -->
            <header>
                <page_info>
                    <title>Integrations</title>
                    <subtitle>Discover and connect your workers to different services</subtitle>
                </page_info>
                <close_button icon="close" action="close_integrations">
                    <tooltip>Close Integrations</tooltip>
                </close_button>
            </header>

            <!-- Search and Filter Section -->
            <search_filter_section>
                <search_bar>
                    <input type="text" placeholder="Search tools, integrations, or capabilities..." />
                    <search_icon>search</search_icon>
                </search_bar>

                <filter_controls>
                    <filter_dropdown id="categories">
                        <label>All Categories</label>
                        <selected_value>All Categories</selected_value>
                        <options>
                            <option value="all">All Categories</option>
                            <option value="communication">Communication</option>
                            <option value="design">Design</option>
                            <option value="analytics">Analytics</option>
                            <option value="development">Development</option>
                            <option value="finance">Finance</option>
                            <option value="productivity">Productivity</option>
                        </options>
                    </filter_dropdown>

                    <filter_dropdown id="integrations">
                        <label>All Integrations</label>
                        <selected_value>All Integrations</selected_value>
                        <options>
                            <option value="all">All Integrations</option>
                            <option value="connected">Connected</option>
                            <option value="available">Available</option>
                            <option value="installing">Installing</option>
                        </options>
                    </filter_dropdown>

                    <sort_dropdown id="sort">
                        <label>Most Popular</label>
                        <selected_value>Most Popular</selected_value>
                        <options>
                            <option value="popular">Most Popular</option>
                            <option value="name">Name (A-Z)</option>
                            <option value="rating">Highest Rated</option>
                            <option value="recent">Recently Added</option>
                        </options>
                    </sort_dropdown>
                </filter_controls>
            </search_filter_section>

            <!-- Main Content Layout -->
            <content_layout>
                <!-- Left Panel: Categories and Quick Actions -->
                <categories_panel>
                    <!-- Categories Section -->
                    <categories_section>
                        <section_title>Categories</section_title>

                        <!-- SAMPLE DATA: Category list with counts -->
                        <category_list>
                            <category_item id="communication" active="true">
                                <icon>message</icon>
                                <label>Communication</label>
                                <count>8</count>
                            </category_item>

                            <category_item id="design">
                                <icon>design_services</icon>
                                <label>Design</label>
                                <count>16</count>
                            </category_item>

                            <category_item id="analytics" highlighted="true">
                                <icon>analytics</icon>
                                <label>Analytics</label>
                                <count>15</count>
                            </category_item>

                            <category_item id="development">
                                <icon>code</icon>
                                <label>Development</label>
                                <count>18</count>
                            </category_item>

                            <category_item id="finance">
                                <icon>account_balance</icon>
                                <label>Finance</label>
                                <count>12</count>
                            </category_item>

                            <category_item id="productivity">
                                <icon>trending_up</icon>
                                <label>Productivity</label>
                                <count>25</count>
                            </category_item>
                        </category_list>
                    </categories_section>

                    <!-- Quick Actions Section -->
                    <quick_actions_section>
                        <section_title>Quick Actions</section_title>

                        <quick_action_list>
                            <!-- SAMPLE DATA: Integration count badge -->
                            <quick_action id="my_integrations">
                                <icon>settings</icon>
                                <label>My Integrations</label>
                                <badge>12</badge>
                                <action>show_my_integrations</action>
                            </quick_action>

                            <quick_action id="recently_added">
                                <icon>fiber_new</icon>
                                <label>Recently Added</label>
                                <action>show_recently_added</action>
                            </quick_action>

                            <quick_action id="most_popular">
                                <icon>trending_up</icon>
                                <label>Most Popular</label>
                                <action>show_most_popular</action>
                            </quick_action>
                        </quick_action_list>
                    </quick_actions_section>
                </categories_panel>

                <!-- Right Panel: Integration Cards -->
                <integrations_panel>
                    <!-- Analytics Category Header -->
                    <category_header>
                        <title>Analytics</title>
                        <!-- SAMPLE DATA: Integration count -->
                        <subtitle>15 integrations available</subtitle>
                    </category_header>

                    <!-- SAMPLE DATA: Integration Cards Grid -->
                    <integrations_grid>
                        <!-- Google Analytics - Connected -->
                        <integration_card id="google_analytics" status="connected">
                            <card_header>
                                <integration_logo>
                                    <icon type="google_analytics">GA</icon>
                                    <logo_background>blue</logo_background>
                                </integration_logo>

                                <integration_info>
                                    <name>Google Analytics</name>
                                    <provider>Google</provider>
                                    <status_badge type="connected">Connected</status_badge>
                                </integration_info>

                                <rating_info>
                                    <rating>4.8</rating>
                                    <rating_count>(7,841)</rating_count>
                                    <stars>5</stars>
                                </rating_info>
                            </card_header>

                            <card_content>
                                <description>Comprehensive web analytics and reporting platform for
                                    tracking website traffic and user behavior.</description>

                                <key_features>
                                    <feature_list>
                                        <feature>Traffic Analysis</feature>
                                        <feature>User Behavior</feature>
                                        <feature>Conversions</feature>
                                    </feature_list>
                                </key_features>
                            </card_content>

                            <card_actions>
                                <primary_button type="secondary">
                                    <label>Manage</label>
                                    <action>manage_integration</action>
                                </primary_button>
                                <menu_button icon="more_vert">
                                    <action>show_options</action>
                                </menu_button>
                            </card_actions>
                        </integration_card>

                        <!-- Mixpanel - Available -->
                        <integration_card id="mixpanel" status="available">
                            <card_header>
                                <integration_logo>
                                    <icon type="mixpanel">MP</icon>
                                    <logo_background>purple</logo_background>
                                </integration_logo>

                                <integration_info>
                                    <name>Mixpanel</name>
                                    <provider>Mixpanel Inc.</provider>
                                    <status_badge type="available">Available</status_badge>
                                </integration_info>

                                <rating_info>
                                    <rating>4.6</rating>
                                    <rating_count>(1,567)</rating_count>
                                    <stars>5</stars>
                                </rating_info>
                            </card_header>

                            <card_content>
                                <description>Product analytics for user behavior insights with
                                    advanced event tracking and funnel analysis.</description>

                                <key_features>
                                    <feature_list>
                                        <feature>Event Tracking</feature>
                                        <feature>Funnels</feature>
                                        <feature>A/B Testing</feature>
                                    </feature_list>
                                </key_features>
                            </card_content>

                            <card_actions>
                                <primary_button type="primary">
                                    <label>Connect</label>
                                    <action>connect_integration</action>
                                </primary_button>
                                <menu_button icon="more_vert">
                                    <action>show_options</action>
                                </menu_button>
                            </card_actions>
                        </integration_card>

                        <!-- Tableau - Available -->
                        <integration_card id="tableau" status="available">
                            <card_header>
                                <integration_logo>
                                    <icon type="tableau">TB</icon>
                                    <logo_background>orange</logo_background>
                                </integration_logo>

                                <integration_info>
                                    <name>Tableau</name>
                                    <provider>Salesforce</provider>
                                    <status_badge type="available">Available</status_badge>
                                </integration_info>

                                <rating_info>
                                    <rating>4.7</rating>
                                    <rating_count>(2,984)</rating_count>
                                    <stars>5</stars>
                                </rating_info>
                            </card_header>

                            <card_content>
                                <description>Advanced data visualization and business intelligence
                                    platform with interactive dashboards.</description>

                                <key_features>
                                    <feature_list>
                                        <feature>Visualization</feature>
                                        <feature>Dashboards</feature>
                                        <feature>BI</feature>
                                    </feature_list>
                                </key_features>
                            </card_content>

                            <card_actions>
                                <primary_button type="primary">
                                    <label>Connect</label>
                                    <action>connect_integration</action>
                                </primary_button>
                                <menu_button icon="more_vert">
                                    <action>show_options</action>
                                </menu_button>
                            </card_actions>
                        </integration_card>

                        <!-- Hotjar - Installing -->
                        <integration_card id="hotjar" status="installing">
                            <card_header>
                                <integration_logo>
                                    <icon type="hotjar">HJ</icon>
                                    <logo_background>red</logo_background>
                                </integration_logo>

                                <integration_info>
                                    <name>Hotjar</name>
                                    <provider>Hotjar Ltd.</provider>
                                    <status_badge type="installing">Installing...</status_badge>
                                </integration_info>

                                <rating_info>
                                    <rating>4.5</rating>
                                    <rating_count>(1,294)</rating_count>
                                    <stars>5</stars>
                                </rating_info>
                            </card_header>

                            <card_content>
                                <description>User behavior analytics and feedback tools with
                                    heatmaps and session recordings.</description>

                                <key_features>
                                    <feature_list>
                                        <feature>Installing...</feature>
                                    </feature_list>
                                </key_features>

                                <!-- Installation Progress -->
                                <installation_progress>
                                    <progress_bar>
                                        <percentage>67%</percentage>
                                        <bar_fill>67</bar_fill>
                                    </progress_bar>
                                    <progress_text>Installing...</progress_text>
                                    <close_button icon="close" action="cancel_installation">
                                        <tooltip>Cancel Installation</tooltip>
                                    </close_button>
                                </installation_progress>
                            </card_content>
                        </integration_card>
                    </integrations_grid>
                </integrations_panel>
            </content_layout>
        </content_area>
    </main_layout>

    <!-- Footer Section -->
    <marketplace_footer>
        <!-- SAMPLE DATA: Integration statistics -->
        <integration_stats>
            <stat_item>
                <value>156</value>
                <label>Total</label>
            </stat_item>
            <stat_item>
                <value>12</value>
                <label>Connected</label>
            </stat_item>
            <stat_item>
                <value>6</value>
                <label>Categories</label>
            </stat_item>
        </integration_stats>

        <!-- Footer Actions -->
        <footer_actions>
            <secondary_actions>
                <button type="secondary">
                    <label>Close</label>
                    <action>close_marketplace</action>
                </button>
                <button type="secondary" icon="settings">
                    <label>Manage My Integrations</label>
                    <action>manage_my_integrations</action>
                </button>
            </secondary_actions>

            <primary_actions>
                <button type="primary" icon="link">
                    <label>Connect Selected</label>
                    <count>0</count>
                    <action>connect_selected_integrations</action>
                </button>
            </primary_actions>
        </footer_actions>
    </marketplace_footer>
</integrations-marketplace> 