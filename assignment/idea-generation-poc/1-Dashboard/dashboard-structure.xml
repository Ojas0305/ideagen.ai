                <!-- Recent Ideas Showcase -->
                <ideas_section>
                    <section_header>
                        <title>Top Performing Ideas</title>
                        <subtitle>Recently generated high-potential ideas</subtitle>
                        <actions>
                            <action_button type="text" action="view_all_ideas">View All Ideas</action_button>
