<?xml version="1.0" encoding="UTF-8"?>
<dashboard>
    <!-- Top Navigation Bar -->
    <top_navigation>
        <left_section>
            <company_logo>
                <name>IdeaGen AI</name>
                <icon>lightbulb_icon</icon>
                <link>/dashboard</link>
            </company_logo>
        </left_section>
        <center_section>
            <search_bar>
                <placeholder>Search projects, ideas, or data sources...</placeholder>
                <search_icon>search</search_icon>
                <filters>
                    <filter type="project">Projects</filter>
                    <filter type="idea">Ideas</filter>
                    <filter type="data">Data Sources</filter>
                </filters>
            </search_bar>
        </center_section>
        <right_section>
            <notifications>
                <notification_icon>notifications</notification_icon>
                <notification_count>5</notification_count>
                <dropdown>
                    <notification type="project_complete">
                        <title>Project "Mobile App Ideas" completed</title>
                        <time>2 hours ago</time>
                    </notification>
                    <notification type="idea_scored">
                        <title>New high-scoring idea generated</title>
                        <time>4 hours ago</time>
                    </notification>
                    <notification type="data_sync">
                        <title>Market research data updated</title>
                        <time>1 day ago</time>
                    </notification>
                </dropdown>
            </notifications>
            <user_profile>
                <avatar>user_avatar.jpg</avatar>
                <name>Sarah Johnson</name>
                <role>Innovation Manager</role>
                <dropdown_menu>
                    <item action="profile">My Profile</item>
                    <item action="settings">Settings</item>
                    <item action="help">Help &amp; Support</item>
                    <item action="logout">Sign Out</item>
                </dropdown_menu>
            </user_profile>
        </right_section>
    </top_navigation>

    <main_layout>
        <!-- Left Sidebar Navigation -->
        <left_sidebar>
            <navigation_title>IDEA GENERATION</navigation_title>
            <nav_items>
                <nav_item id="dashboard" icon="dashboard" active="true">
                    <label>Dashboard</label>
                    <target_content>/dashboard</target_content>
                </nav_item>
                <nav_item id="projects" icon="folder">
                    <label>Projects</label>
                    <target_content>/projects</target_content>
                </nav_item>
                <nav_item id="data-sources" icon="database">
                    <label>Data Sources</label>
                    <target_content>/data-sources</target_content>
                </nav_item>
                <nav_item id="ai-personas" icon="psychology">
                    <label>AI Personas</label>
                    <target_content>/ai-personas</target_content>
                </nav_item>
                <nav_item id="idea-workspace" icon="lightbulb">
                    <label>Idea Workspace</label>
                    <target_content>/idea-workspace</target_content>
                </nav_item>
                <nav_item id="evaluation" icon="assessment">
                    <label>Evaluation</label>
                    <target_content>/evaluation</target_content>
                </nav_item>
                <nav_item id="export" icon="file_download">
                    <label>Export</label>
                    <target_content>/export</target_content>
                </nav_item>
            </nav_items>
        </left_sidebar>

        <!-- Main Content Area -->
        <main_content>
            <!-- Dashboard Header -->
            <dashboard_header>
                <title>Innovation Dashboard</title>
                <subtitle>Manage your AI-powered idea generation projects</subtitle>
                <quick_actions>
                    <action_button type="primary" action="new_project">
                        <icon>add</icon>
                        <label>New Project</label>
                    </action_button>
                    <action_button type="secondary" action="start_session">
                        <icon>play_arrow</icon>
                        <label>Start Session</label>
                    </action_button>
                    <action_button type="secondary" action="connect_data">
                        <icon>link</icon>
                        <label>Connect Data</label>
                    </action_button>
                    <action_button type="outline" action="review_ideas">
                        <icon>rate_review</icon>
                        <label>Review Ideas</label>
                    </action_button>
                </quick_actions>
            </dashboard_header>

            <!-- Key Performance Indicators -->
            <kpi_section>
                <kpi_card>
                    <title>Active Projects</title>
                    <value>12</value>
                    <trend type="positive">+8%</trend>
                    <icon>folder_open</icon>
                    <description>Projects in progress</description>
                </kpi_card>
                <kpi_card>
                    <title>Ideas Generated</title>
                    <value>247</value>
                    <trend type="positive">+23%</trend>
                    <icon>lightbulb</icon>
                    <description>Total ideas this month</description>
                </kpi_card>
                <kpi_card>
                    <title>Success Rate</title>
                    <value>76%</value>
                    <trend type="positive">+5%</trend>
                    <icon>trending_up</icon>
                    <description>Ideas advancing to implementation</description>
                </kpi_card>
                <kpi_card>
                    <title>Processing Time</title>
                    <value>4.2h</value>
                    <trend type="negative">-0.8h</trend>
                    <icon>schedule</icon>
                    <description>Average time to full ideas</description>
                </kpi_card>
            </kpi_section>

